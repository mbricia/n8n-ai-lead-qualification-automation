      "id": "e0d4038f-e4a0-4932-956c-46868b05bec6",
      "name": "[LOGIC] Calculate Lead Score"
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=You are a professional client intake assistant for a digital services business.\n\nWrite a concise, friendly, and professional email reply to the client based only on the information provided below.\n\nClient name: {{ $json.client_name }}\nCompany: {{ $json.company_name }}\nProject type: {{ $json.project_type }}\nRequirements: {{ $json.requirements }}\nBudget: {{ $json.budget_amount }} {{ $json.budget_currency }}\nTimeline: {{ $json.deadline }}\nLead quality: {{ $json.lead_quality }}\n\nInstructions:\n- Thank the client for reaching out.\n- Mention their project naturally so the reply feels personalized.\n- Do not promise pricing, availability, or a delivery date.\n- Do not invent any information.\n- If the lead quality is Hot, show strong interest and suggest scheduling a short discovery call.\n- If the lead quality is Warm, acknowledge the project and suggest discussing the requirements further.\n- If the lead quality is Cold, politely acknowledge the inquiry and say the details will be reviewed.\n- Keep the email between 80 and 130 words.\n- Do not include a subject line.\n- Do not use placeholders.\n- End with \"Best regards,\"",
        "batching": {}
      },
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.9,
