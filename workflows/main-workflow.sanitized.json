    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const data = $json;\n\nconst missingFields = [];\nconst validationIssues = [];\n\n// Check required fields\nif (!String(data.client_name || '').trim()) {\n  missingFields.push('client_name');\n}\n\nif (!String(data.client_email || '').trim()) {\n  missingFields.push('client_email');\n}\n\nif (!String(data.inquiry_message || '').trim()) {\n  missingFields.push('inquiry_message');\n}\n\n// Check email format only if an email was provided\nconst email = String(data.client_email || '').trim();\nconst emailPattern = /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/;\n\nif (email && !emailPattern.test(email)) {\n  validationIssues.push('Invalid email format');\n}\n\n// Build readable validation reason\nlet validationReason = '';\n\nif (missingFields.length > 0) {\n  validationReason = `Missing required field(s): ${missingFields.join(', ')}`;\n}\n\nif (validationIssues.length > 0) {\n  if (validationReason) {\n    validationReason += ` | ${validationIssues.join(' | ')}`;\n  } else {\n    validationReason = validationIssues.join(' | ');\n  }\n}\n\nreturn {\n  json: {\n    ...data,\n    validation_status: 'Invalid',\n    missing_fields: missingFields,\n    validation_issues: validationIssues,\n    validation_reason: validationReason,\n    rejected_at: new Date().toISOString()\n  }\n};"
      },
