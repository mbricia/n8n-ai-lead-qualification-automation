    {
      "parameters": {
        "jsCode": "const lead = $('[DATA] Build Lead Record').first().json;\n\nlet score = 0;\nconst reasons = [];\n\n// 1. Required contact information — 10 points\nif (\n  lead.client_name &&\n  lead.client_email &&\n  lead.inquiry_message\n) {\n  score += 10;\n  reasons.push('Complete contact information');\n}\n\n// 2. Clear project type — 25 points\nconst projectType = String(lead.project_type || '').toLowerCase();\n\nif (\n  projectType &&\n  projectType !== 'unknown' &&\n  projectType !== 'other'\n) {\n  score += 25;\n  reasons.push('Clear project type');\n}\n\n// 3. Budget information — 25 points total\nconst budgetAmount = Number(lead.budget_amount);\nconst budgetCurrency = String(lead.budget_currency || '').toUpperCase();\n\nif (Number.isFinite(budgetAmount) && budgetAmount > 0) {\n  score += 15;\n  reasons.push('Budget amount provided');\n}\n\nif (\n  budgetCurrency &&\n  budgetCurrency !== 'UNKNOWN'\n) {\n  score += 10;\n  reasons.push('Budget currency provided');\n}\n\n// 4. Deadline / timeline — 20 points\nconst deadline = String(lead.deadline || '').toLowerCase();\n\nif (deadline && deadline !== 'unknown') {\n  score += 20;\n  reasons.push('Project timeline provided');\n}\n\n// 5. Requirements clarity — 20 points\nconst requirements = String(lead.requirements || '').trim();\n\nif (\n  requirements &&\n  requirements.toLowerCase() !== 'unknown'\n) {\n  if (requirements.length >= 40) {\n    score += 20;\n    reasons.push('Detailed project requirements');\n  } else {\n    score += 10;\n    reasons.push('Basic project requirements');\n  }\n}\n\n// Lead classification\nlet leadQuality;\n\nif (score >= 80) {\n  leadQuality = 'Hot';\n} else if (score >= 50) {\n  leadQuality = 'Warm';\n} else {\n  leadQuality = 'Cold';\n}\n\nreturn {\n  json: {\n    ...lead,\n    lead_score: score,\n    lead_quality: leadQuality,\n    score_reasons: reasons\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
